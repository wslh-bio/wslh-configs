profiles {
    awsdev {
        process.executor = 'awsbatch'
        process.queue = 'dev_wslh_nextflow_nextflow_job'
        workDir = 's3://dev-wslh-sequencing-analyses/work/'
        aws.region = 'us-east-2'
        aws.batch.cliPath = '/home/ec2-user/miniconda/bin/aws'
        docker.enabled = true
        aws.client.anonymous = false
    }
    awsprod {
        process.executor = 'awsbatch'
        process.queue = 'prod_wslh_nextflow_nextflow_job'
        workDir = 's3://prod-wslh-sequencing-analyses/work/'
        aws.region = 'us-east-2'
        aws.batch.cliPath = '/home/ec2-user/miniconda/bin/aws'
        docker.enabled = true
        aws.client.anonymous = false
    }
    awsdev_mountpoint {
        process.containerOptions = '-v /s3:/s3:rw'
        process.executor = 'awsbatch'
        process.queue = 'dev_wslh_nextflow_nextflow_job'
        workDir = '/s3/dev-wslh-sequencing-analyses/work/'
        aws.region = 'us-east-2'
        aws.batch.cliPath = '/home/ec2-user/miniconda/bin/aws'
        docker.enabled = true
        aws.client.anonymous = false
    }
    awsprod_mountpoint {
        process.containerOptions = '-v /s3:/s3:rw'
        process.executor = 'awsbatch'
        process.queue = 'prod_wslh_nextflow_nextflow_job'
        workDir = '/s3/prod-wslh-sequencing-analyses/work/'
        aws.region = 'us-east-2'
        aws.batch.cliPath = '/home/ec2-user/miniconda/bin/aws'
        docker.enabled = true
        aws.client.anonymous = false
    }
}
